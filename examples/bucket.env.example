# Copy to credentials/bucket.env (ignored by Git), or the external
# home default ~/.config/iride-s3/credentials.env.
# Obtain these values from the IRIDE production access administrator.
IRIDE_S3_ENDPOINT="https://s3-servicesegment.iride.earth"
IRIDE_PROD_ACCESS_KEY="REPLACE_WITH_PRODUCTION_ACCESS_KEY"
IRIDE_PROD_SECRET_KEY="REPLACE_WITH_PRODUCTION_SECRET_KEY"
