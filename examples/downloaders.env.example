# Place the filled file at credentials/downloaders.env (ignored by Git),
# or ~/.config/iride-validation/downloaders.env, or pass it with
# --downloader-credentials-file /private/path/downloaders.env.
# Blank fields are allowed. Do not source/execute this file.
# CURRENT LANDSAT DOWNLOADS: public Planetary Computer, no personal login.
# Optional subscription key, only if your organization already has one:
PLANETARY_COMPUTER_SUBSCRIPTION_KEY=""

# ERA5-Land (product 03): reserved until adapter is implemented
CDS_URL=""
CDS_KEY=""
# Atmospheric Data Store: optional future input/reference provider
ADS_URL=""
ADS_KEY=""
# MSG/SEVIRI (product 06): reserved until adapter is implemented
EUMETSAT_CONSUMER_KEY=""
EUMETSAT_CONSUMER_SECRET=""
# Sentinel-2 / Copernicus Data Space (product 05)
CDSE_USER=""
CDSE_PASSWORD=""
# GOSAT CH4/CO2 (products 07/08)
NIES_USER=""
NIES_PASSWORD=""
# Optional existing providers / future integrations
EARTHDATA_USER=""
EARTHDATA_PASSWORD=""
CMEMS_USER=""
CMEMS_PASSWORD=""
GPORTAL_USER=""
GPORTAL_PASSWORD=""
METEOHUB_BASE_URL=""
METEOHUB_RADAR_DATASET=""
METEOHUB_MAX_DOWNLOAD_MB=""
METEOHUB_ARCO_ACCESS_KEY=""
METEOHUB_USER=""
METEOHUB_PASSWORD=""
# AERONET public downloads currently need no login.
# Regional gauge access must be checked for the selected network.
